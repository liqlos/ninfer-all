function(ninfer_gate_targets)
  add_library(ninfer_gate_bench OBJECT /lab/results/gate-bf16-pr/swiglu-bench.cu)
  ninfer_internal_includes(ninfer_gate_bench)
  target_include_directories(ninfer_gate_bench PRIVATE ${PROJECT_SOURCE_DIR}/bench ${PROJECT_SOURCE_DIR}/bench/ops)
  target_compile_definitions(ninfer_gate_bench PRIVATE main=ninfer_bundle_entry_lab_swiglu_bench)
  target_link_libraries(ninfer_gate_bench PRIVATE ninfer_ops)
  target_compile_options(ninfer_gate_bench PRIVATE $<$<COMPILE_LANGUAGE:CUDA>:-lineinfo>)
  add_executable(ninfer_gate_check /lab/results/gate-bf16-pr/driver.cpp)
  target_link_libraries(ninfer_gate_check PRIVATE ninfer_gate_bench ninfer_linear_gguf_test ninfer_linear_gguf_mmq_store_test ninfer_linear_bench ninfer_ops)
endfunction()
cmake_language(DEFER CALL ninfer_gate_targets)
