function(ninfer_pr_target)
  get_target_property(op_sources ninfer_ops SOURCES)
  list(FILTER op_sources EXCLUDE REGEX "/softmax_attention/")
  set_property(TARGET ninfer_ops PROPERTY SOURCES ${op_sources})
  add_executable(ninfer_pr_check /lab/results/bf16-store-pr/build-inputs/driver.cpp)
  target_link_libraries(ninfer_pr_check PRIVATE ninfer_linear_gguf_test ninfer_linear_bench ninfer_ops)
  if(TARGET ninfer_linear_gguf_mmq_store_test)
    target_link_libraries(ninfer_pr_check PRIVATE ninfer_linear_gguf_mmq_store_test)
    target_compile_definitions(ninfer_pr_check PRIVATE PR_HAS_STORE=1)
  else()
    target_compile_definitions(ninfer_pr_check PRIVATE PR_HAS_STORE=0)
  endif()
endfunction()
cmake_language(DEFER CALL ninfer_pr_target)
