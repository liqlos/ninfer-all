+__launch_bounds__(kVecWarps * 32) __global__ void kernel_t4_warp_token(VecArgs p) {
+    using D = Decoder<type>;
+    constexpr int kPerBlock = D::kBlockElems / 32;
+    constexpr int kTable = D::kTableWords > 0 ? D::kTableWords : 4;
